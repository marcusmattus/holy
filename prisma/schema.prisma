generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  projects             Project[]
  payouts              Payout[]
  creatorPayoutAccount CreatorPayoutAccount?
  revenueShareRules    RevenueShareRule[]
  revenueShares        RevenueShare[]        @relation("RevenueShareRecipient")
  rewardLedgerEntries  RewardLedger[]
  referralsAsReferrer  Referral[]            @relation("ReferralReferrer")
  referralsAsReferred  Referral[]            @relation("ReferralReferred")
  installs             Install[]
  ownedWorkspaces      Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  purchases            Purchase[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Project {
  id           String                  @id @default(cuid())
  name         String
  slug         String?                 @unique
  description  String?
  userId       String
  user         User                    @relation(fields: [userId], references: [id])
  workspaceId  String?
  workspace    Workspace?              @relation(fields: [workspaceId], references: [id])
  status       ProjectStatus           @default(DRAFT)
  files        ProjectFile[]
  versions     ProjectVersion[]
  listing      StoreListing?
  deployments  Deployment[]
  analytics    AnalyticsDailyAggregate[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, path])
}

model ProjectVersion {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String?
  prompt    String?
  summary   String?
  filesJson Json
  createdAt DateTime @default(now())
}

model StoreListing {
  id                String                  @id @default(cuid())
  projectId         String                  @unique
  project           Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug              String                  @unique
  name              String
  title             String
  description       String
  category          String                  @default("General")
  price             Float?
  priceType         StoreListingPriceType   @default(FREE)
  priceCents        Int                     @default(0)
  currency          String                  @default("gbp")
  status            ListingStatus           @default(DRAFT)
  isPublished       Boolean                 @default(false)
  installs          Install[]
  purchases         Purchase[]
  revenueShareRules RevenueShareRule[]
  referrals         Referral[]
  analytics         AnalyticsDailyAggregate[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

model Deployment {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  provider   String   @default("simulated")
  externalId String?
  url        String?
  status     String
  logs       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CreatorPayoutAccount {
  id               String              @id @default(cuid())
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeAccountId  String              @unique
  onboardingStatus PayoutAccountStatus @default(PENDING)
  payoutsEnabled   Boolean             @default(false)
  chargesEnabled   Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model Payout {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  amountCents      Int
  currency         String       @default("gbp")
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?      @unique
  metadata         Json?
  revenueShares    RevenueShare[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model RevenueShare {
  id          String             @id @default(cuid())
  purchaseId  String?
  purchase    Purchase?          @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  listingId   String?
  recipientId String
  recipient   User               @relation("RevenueShareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  role        RevenueShareRole?
  amountCents Int
  currency    String             @default("gbp")
  status      RevenueShareStatus @default(PENDING)
  payoutId    String?
  referralCode String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  payout      Payout?            @relation(fields: [payoutId], references: [id])
}

model RevenueShareRule {
  id          String           @id @default(cuid())
  listingId   String
  listing     StoreListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  role        RevenueShareRole
  basisPoints Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([listingId, recipientId, role])
}

model AnalyticsEvent {
  id           String   @id @default(cuid())
  eventType    String
  projectId    String?
  listingId    String?
  userId       String?
  revenueCents Int      @default(0)
  metadata     Json?
  createdAt    DateTime @default(now())
}

model AnalyticsDailyAggregate {
  id           String       @id @default(cuid())
  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id])
  listingId    String?
  listing      StoreListing? @relation(fields: [listingId], references: [id])
  date         DateTime
  views        Int          @default(0)
  installs     Int          @default(0)
  purchases    Int          @default(0)
  revenueCents Int          @default(0)
  referrals    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([projectId, listingId, date])
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  ownerId   String
  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members   WorkspaceMember[]
  projects  Project[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
}

model RewardLedger {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType       RewardSourceType
  sourceId         String?
  amount           Int
  currency         RewardCurrency   @default(POINTS)
  status           RewardStatus     @default(PENDING)
  description      String?
  metadata         Json?
  settlementProvider String?
  settlementTxHash String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model AppInstall {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model AppPurchase {
  id                String   @id @default(cuid())
  userId            String
  listingId         String
  providerSessionId String
  createdAt         DateTime @default(now())

  @@unique([providerSessionId])
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())
}

model Install {
  id        String       @id @default(cuid())
  listingId String
  listing   StoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([listingId, userId])
}

model Purchase {
  id                  String          @id @default(cuid())
  listingId           String
  listing             StoreListing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId             String
  buyer               User            @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  amountCents         Int
  currency            String          @default("gbp")
  status              PurchaseStatus  @default(PENDING)
  stripeSessionId     String?         @unique
  stripePaymentIntent String?         @unique
  revenueShares       RevenueShare[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Referral {
  id         String         @id @default(cuid())
  referrerId String
  referrer   User           @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId String?
  referred   User?          @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: SetNull)
  listingId  String?
  listing    StoreListing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  code       String         @unique
  status     ReferralStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

enum PayoutAccountStatus {
  PENDING
  ONBOARDING
  ACTIVE
  RESTRICTED
  DISABLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum ProjectStatus {
  DRAFT
  BUILDING
  READY
  PUBLISHED
  ARCHIVED
}

enum StoreListingPriceType {
  FREE
  ONE_TIME
  SUBSCRIPTION
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  UNLISTED
  ARCHIVED
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RevenueShareRole {
  CREATOR
  REFERRER
  PLATFORM
  COLLABORATOR
}

enum RevenueShareStatus {
  AVAILABLE
  PENDING
  PAID_OUT
  CANCELLED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum RewardSourceType {
  PURCHASE
  INSTALL
  REFERRAL
  PUBLISH
  MANUAL
}

enum RewardCurrency {
  POINTS
  GBP_CENTS
  USD_CENTS
  USDC_UNITS
}

enum RewardStatus {
  PENDING
  AVAILABLE
  SETTLED
  CANCELLED
}

enum ReferralStatus {
  PENDING
  CONVERTED
  EXPIRED
}
