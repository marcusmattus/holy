generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  projects             Project[]
  payouts              Payout[]
  creatorPayoutAccount CreatorPayoutAccount?
  revenueShares        RevenueShare[]        @relation("RevenueShareRecipient")
  ownedWorkspaces      Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  createdAt            DateTime              @default(now())
  id                   String             @id @default(cuid())
  email                String             @unique
  projects             Project[]
  purchases            Purchase[]
  revenueShareRules    RevenueShareRule[]
  revenueShares        RevenueShare[]
  rewardLedgerEntries  RewardLedger[]
  referralsAsReferrer  Referral[]         @relation("ReferralReferrer")
  referralsAsReferred  Referral[]         @relation("ReferralReferred")
  installs             Install[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Project {
  id           String           @id @default(cuid())
  name         String
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  workspaceId  String?
  workspace    Workspace?       @relation(fields: [workspaceId], references: [id])
  versions     ProjectVersion[]
  listings     StoreListing[]
  deployments  Deployment[]
  analytics    AnalyticsDailyAggregate[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  id        String    @id @default(cuid())
  email     String    @unique
  projects  Project[]
  installs  Install[]
  createdAt DateTime  @default(now())
}

model Project {
  id          String           @id @default(cuid())
  name        String
  slug        String?          @unique
  description String?
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  status      ProjectStatus    @default(DRAFT)
  files       ProjectFile[]
  versions    ProjectVersion[]
  listing     StoreListing?
  deployments Deployment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, path])
}

model ProjectVersion {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String?
  prompt    String?
  summary   String?
  filesJson Json
  createdAt DateTime @default(now())
}

model StoreListing {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  slug        String   @unique
  name        String
  description String
  category    String   @default("General")
  price       Float?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  analytics   AnalyticsDailyAggregate[]
  id                String                @id @default(cuid())
  projectId         String
  project           Project               @relation(fields: [projectId], references: [id])
  name              String
  title             String
  slug              String                @unique
  description       String
  price             Float?
  priceType         StoreListingPriceType @default(FREE)
  priceCents        Int                   @default(0)
  currency          String                @default("gbp")
  isPublished       Boolean               @default(false)
  installs          Install[]
  purchases         Purchase[]
  revenueShareRules RevenueShareRule[]
  referrals         Referral[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  id          String         @id @default(cuid())
  projectId   String         @unique
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  slug        String         @unique
  description String
  category    String?
  priceType   PriceType      @default(FREE)
  priceCents  Int            @default(0)
  status      ListingStatus  @default(DRAFT)
  installs    Install[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Install {
  id        String       @id @default(cuid())
  listingId String
  listing   StoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())
  id               String            @id @default(cuid())
  email            String            @unique
  projects         Project[]
  installs         Install[]
  rewardLedgers    RewardLedger[]
  revenueScenarios RevenueScenario[]
  analyticsEvents  AnalyticsEvent[]
  createdAt        DateTime          @default(now())
}

model Project {
  id               String            @id @default(cuid())
  name             String
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  versions         ProjectVersion[]
  listings         StoreListing[]
  installs         Install[]
  rewardLedgers    RewardLedger[]
  revenueScenarios RevenueScenario[]
  analyticsEvents  AnalyticsEvent[]
  deployments      Deployment[]
  createdAt        DateTime          @default(now())
}

model ProjectVersion {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  prompt     String?
  spec       String?
  fileTree   Json?
  code       String
  createdAt  DateTime @default(now())
}

model StoreListing {
  id             String           @id @default(cuid())
  projectId      String           @unique
  project        Project          @relation(fields: [projectId], references: [id])
  name           String
  slug           String           @unique
  description    String
  price          Float?
  pricingModel   PricingModel     @default(FREE)
  isPublished    Boolean          @default(false)
  installs       Install[]
  rewardLedgers  RewardLedger[]
  analyticsEvents AnalyticsEvent[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Deployment {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  provider   String   @default("simulated")
  externalId String?
  url        String?
  status     String
  logs       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CreatorPayoutAccount {
  id               String              @id @default(cuid())
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeAccountId  String              @unique
  onboardingStatus PayoutAccountStatus @default(PENDING)
  payoutsEnabled   Boolean             @default(false)
  chargesEnabled   Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model Payout {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  amountCents      Int
  currency         String       @default("gbp")
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?      @unique
  metadata         Json?
  revenueShares    RevenueShare[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model RevenueShare {
  id            String             @id @default(cuid())
  recipientId   String
  recipient     User               @relation("RevenueShareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  listingId     String?
  amountCents   Int
  currency      String             @default("gbp")
  status        RevenueShareStatus @default(AVAILABLE)
  payoutId      String?
  referralCode  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  payout        Payout?            @relation(fields: [payoutId], references: [id])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventType  String
  projectId  String?
  listingId  String?
  userId     String?
  revenueCents Int    @default(0)
  metadata   Json?
  createdAt  DateTime @default(now())
}

model AnalyticsDailyAggregate {
  id           String   @id @default(cuid())
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  listingId    String?
  listing      StoreListing? @relation(fields: [listingId], references: [id])
  date         DateTime
  views        Int      @default(0)
  installs     Int      @default(0)
  purchases    Int      @default(0)
  revenueCents Int      @default(0)
  referrals    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([projectId, listingId, date])
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  ownerId   String
  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members   WorkspaceMember[]
  projects  Project[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
}

model RewardLedger {
  id                  String   @id @default(cuid())
  userId              String
  amountCents         Int
  currency            String   @default("gbp")
  settlementProvider  String?
  settlementTxHash    String?
  createdAt           DateTime @default(now())
}

model AppInstall {
  id         String   @id @default(cuid())
  userId     String
  listingId  String
  createdAt  DateTime @default(now())

  @@unique([userId, listingId])
}

model AppPurchase {
  id                 String   @id @default(cuid())
  userId             String
  listingId          String
  providerSessionId  String
  createdAt          DateTime @default(now())

  @@unique([providerSessionId])
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())
}

enum PayoutAccountStatus {
  PENDING
  ONBOARDING
  ACTIVE
  RESTRICTED
  DISABLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum RevenueShareStatus {
  AVAILABLE
  PENDING
  PAID_OUT
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Install {
  id        String       @id @default(cuid())
  listingId String
  listing   StoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([listingId, userId])
}

model Purchase {
  id                  String          @id @default(cuid())
  listingId           String
  listing             StoreListing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId             String
  buyer               User            @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  amountCents         Int
  currency            String          @default("gbp")
  status              PurchaseStatus  @default(PENDING)
  stripeSessionId     String?         @unique
  stripePaymentIntent String?         @unique
  revenueShares       RevenueShare[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model RevenueShareRule {
  id          String           @id @default(cuid())
  listingId   String
  listing     StoreListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  role        RevenueShareRole
  basisPoints Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([listingId, recipientId, role])
}

model RevenueShare {
  id          String             @id @default(cuid())
  purchaseId  String
  purchase    Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User               @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  role        RevenueShareRole
  amountCents Int
  currency    String             @default("gbp")
  status      RevenueShareStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model RewardLedger {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType      RewardSourceType
  sourceId        String?
  amount          Int
  currency        RewardCurrency   @default(POINTS)
  status          RewardStatus     @default(PENDING)
  description     String?
  metadata        Json?
  settlementTxHash String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Referral {
  id         String         @id @default(cuid())
  referrerId String
  referrer   User           @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId String?
  referred   User?          @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: SetNull)
  listingId  String?
  listing    StoreListing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  code       String         @unique
  status     ReferralStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

enum StoreListingPriceType {
  FREE
  ONE_TIME
  SUBSCRIPTION
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RevenueShareRole {
  CREATOR
  REFERRER
  PLATFORM
  COLLABORATOR
}

enum RevenueShareStatus {
  PENDING
  AVAILABLE
  PAID_OUT
  CANCELLED
}

enum RewardSourceType {
  PURCHASE
  INSTALL
  REFERRAL
  PUBLISH
  MANUAL
}

enum RewardCurrency {
  POINTS
  GBP_CENTS
  USD_CENTS
  USDC_UNITS
}

enum RewardStatus {
  PENDING
  AVAILABLE
  SETTLED
  CANCELLED
}

enum ReferralStatus {
  PENDING
  CONVERTED
  EXPIRED
enum ProjectStatus {
  DRAFT
  BUILDING
  READY
  PUBLISHED
  ARCHIVED
}

enum PriceType {
  FREE
  ONE_TIME
  SUBSCRIPTION
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  UNLISTED
  ARCHIVED
model Install {
  id          String       @id @default(cuid())
  listingId   String
  listing     StoreListing @relation(fields: [listingId], references: [id])
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  pricePaid   Float?
  source      String?
  createdAt   DateTime     @default(now())

  @@index([userId, listingId, projectId])
}

model RewardLedger {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id])
  listingId   String?
  listing     StoreListing?  @relation(fields: [listingId], references: [id])
  kind        RewardKind
  amountCents Int
  currency    String         @default("USD")
  note        String?
  createdAt   DateTime       @default(now())
}

model RevenueScenario {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id])
  projectId               String?
  project                 Project? @relation(fields: [projectId], references: [id])
  monthlyActiveUsers      Int      @default(0)
  conversionRate          Float    @default(0)
  averageRevenuePerUser   Float    @default(0)
  projectedMonthlyRevenue Float    @default(0)
  createdAt               DateTime @default(now())
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  userId     String?
  user       User?              @relation(fields: [userId], references: [id])
  projectId  String?
  project    Project?           @relation(fields: [projectId], references: [id])
  listingId  String?
  listing    StoreListing?      @relation(fields: [listingId], references: [id])
  eventName  AnalyticsEventName
  source     String?
  metadata   Json?
  createdAt  DateTime           @default(now())
}

enum PricingModel {
  FREE
  PAID
  SUBSCRIPTION
}

enum RewardKind {
  CREATOR_EARNING
  REFERRAL_REWARD
}

enum AnalyticsEventName {
  APP_VIEW
  STORE_VIEW
  INSTALL_CLICK
  INSTALL_COMPLETED
  PURCHASE_COMPLETED
  DEPLOYMENT_CREATED
}

model Workspace {
  id                        String                 @id @default(cuid())
  userId                    String
  user                      User                   @relation(fields: [userId], references: [id])
  name                      String
  strictMode                Boolean                @default(false)
  allowAggregatedLearning   Boolean                @default(true)
  allowAnonymizedBenchmarking Boolean              @default(true)
  disablePersonalizedRecommendations Boolean       @default(false)
  optimizationCampaigns     OptimizationCampaign[]
  intelligencePolicies      WorkspaceIntelligencePolicy[]
  federatedModelUpdates     FederatedModelUpdate[]
  tenantMigrationRuns       TenantMigrationRun[]
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
}

model RegionControlPlane {
  id                String       @id @default(cuid())
  region            DataRegion
  name              String
  status            RegionStatus @default(ACTIVE)
  priority          Int          @default(100)
  metadata          Json?
  lastHealthCheckAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model RegionFailoverEvent {
  id           String         @id @default(cuid())
  fromRegion   DataRegion
  toRegion     DataRegion
  reason       String
  status       FailoverStatus @default(PROPOSED)
  approvedById String?
  approvedBy   User?          @relation("RegionFailoverApprover", fields: [approvedById], references: [id])
  executedAt   DateTime?
  metadata     Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model FederatedLearningRound {
  id          String                @id @default(cuid())
  name        String
  status      FederatedRoundStatus  @default(DRAFT)
  target      FederatedLearningTarget
  config      Json?
  startedAt   DateTime?
  completedAt DateTime?
  updates     FederatedModelUpdate[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model FederatedModelUpdate {
  id                String                 @id @default(cuid())
  roundId           String
  round             FederatedLearningRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  workspaceId       String?
  workspace         Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  signalHash        String
  updateJson        Json
  sampleSize        Int
  privacyBudgetUsed Float                  @default(0)
  accepted          Boolean                @default(false)
  createdAt         DateTime               @default(now())
}

model OptimizationCampaign {
  id          String                 @id @default(cuid())
  workspaceId String
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  schedules   OptimizationSchedule[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model OptimizationSchedule {
  id         String               @id @default(cuid())
  campaignId String
  campaign   OptimizationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  cron       String
  enabled    Boolean              @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

model MarketplaceAbuseSignal {
  id         String                     @id @default(cuid())
  targetType MarketplaceAbuseTargetType
  targetId   String
  signalType MarketplaceAbuseSignalType
  score      Float
  metadata   Json?
  createdAt  DateTime                   @default(now())
}

model MarketplaceEnforcementAction {
  id           String                       @id @default(cuid())
  targetType   MarketplaceAbuseTargetType
  targetId     String
  action       MarketplaceEnforcementType
  status       MarketplaceEnforcementStatus @default(PROPOSED)
  reason       String
  approvedById String?
  approvedBy   User?                        @relation("MarketplaceEnforcementApprover", fields: [approvedById], references: [id])
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
}

model TenantMigrationRun {
  id           String                @id @default(cuid())
  workspaceId  String
  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromRegion   DataRegion
  toRegion     DataRegion
  status       TenantMigrationStatus @default(DRAFT)
  plan         Json
  dryRunResult Json?
  executedAt   DateTime?
  approvedById String?
  approvedBy   User?                 @relation("TenantMigrationApprover", fields: [approvedById], references: [id])
  rollbackPlan Json?
  error        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model StatusComponent {
  id          String                @id @default(cuid())
  name        String
  slug        String                @unique
  description String?
  status      PublicComponentStatus @default(OPERATIONAL)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model PublicIncident {
  id         String               @id @default(cuid())
  title      String
  impact     PublicIncidentImpact
  status     PublicIncidentStatus @default(INVESTIGATING)
  summary    String
  visible    Boolean              @default(false)
  startedAt  DateTime             @default(now())
  resolvedAt DateTime?
  updates    PublicIncidentUpdate[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

model PublicIncidentUpdate {
  id         String         @id @default(cuid())
  incidentId String
  incident   PublicIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  message    String
  createdAt  DateTime       @default(now())
}

model WorkspaceIntelligencePolicy {
  id                               String    @id @default(cuid())
  workspaceId                      String
  workspace                        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  allowAggregatedLearning          Boolean   @default(true)
  optedOutOfGlobalIntelligence     Boolean   @default(false)
  allowAnonymizedBenchmarking      Boolean   @default(true)
  disablePersonalizedRecommendations Boolean @default(false)
  strictModeDefaultsConservative   Boolean   @default(true)
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt
}

enum DataRegion {
  US_EAST
  US_WEST
  EU_CENTRAL
  AP_SOUTHEAST
}

enum RegionStatus {
  ACTIVE
  DEGRADED
  FAILING_OVER
  DISABLED
}

enum FailoverStatus {
  PROPOSED
  APPROVED
  EXECUTED
  FAILED
  CANCELLED
}

enum FederatedRoundStatus {
  DRAFT
  RUNNING
  AGGREGATING
  COMPLETED
  FAILED
  CANCELLED
}

enum FederatedLearningTarget {
  MARKETPLACE_RANKING
  SEARCH_RELEVANCE
  OPTIMIZATION_RECOMMENDATIONS
  ABUSE_DETECTION
  AGENT_QUALITY
}

enum MarketplaceAbuseTargetType {
  STORE_LISTING
  TEMPLATE
  AGENT_LISTING
  WORKFLOW_TEMPLATE
  PLUGIN
  REVIEW
  CREATOR_PROFILE
}

enum MarketplaceAbuseSignalType {
  SUSPICIOUS_VELOCITY
  REVIEW_PATTERN
  DUPLICATE_CONTENT
  REPORT_SPIKE
  REFUND_SPIKE
  REFERRAL_ABUSE
  RANKING_MANIPULATION
}

enum MarketplaceEnforcementType {
  DEMOTE
  HIDE
  SUSPEND
  REQUIRE_REVIEW
  REMOVE_REVIEW
}

enum MarketplaceEnforcementStatus {
  PROPOSED
  APPROVED
  APPLIED
  DISMISSED
}

enum TenantMigrationStatus {
  DRAFT
  DRY_RUN_COMPLETE
  APPROVED
  RUNNING
  COMPLETED
  FAILED
  ROLLED_BACK
  CANCELLED
}

enum PublicComponentStatus {
  OPERATIONAL
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
  MAINTENANCE
}

enum PublicIncidentImpact {
  NONE
  MINOR
  MAJOR
  CRITICAL
}

enum PublicIncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

model Workspace {
  id                  String                     @id @default(cuid())
  name                String
  strictDataResidency Boolean                    @default(false)
  intelligenceOptOut  Boolean                    @default(false)
  recommendations     IntelligenceRecommendation[]
  campaigns           OptimizationCampaign[]
  bundles             ImprovementBundle[]
  createdAt           DateTime                   @default(now())
}

model SelfHealingRun {
  id              String                 @id @default(cuid())
  triggerType     SelfHealingTriggerType
  sourceType      String?
  sourceId        String?
  status          SelfHealingRunStatus   @default(PENDING)
  diagnosis       Json?
  proposedActions Json?
  appliedActions  Json?
  riskLevel       SuggestionImpact       @default(MEDIUM)
  error           String?
  approvedById    String?
  approvedBy      User?                  @relation("SelfHealingApprover", fields: [approvedById], references: [id])
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model GlobalPatternSignal {
  id         String           @id @default(cuid())
  signalType GlobalSignalType
  scope      String
  value      Float
  confidence Float            @default(0)
  sampleSize Int              @default(0)
  metadata   Json?
  createdAt  DateTime         @default(now())
}

model IntelligenceRecommendation {
  id          String                           @id @default(cuid())
  workspaceId String?
  workspace   Workspace?                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        IntelligenceRecommendationType
  title       String
  description String
  confidence  Float                            @default(0)
  evidence    Json?
  status      SuggestionStatus                 @default(PENDING)
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt
}

model OptimizationCampaign {
  id            String                      @id @default(cuid())
  workspaceId   String?
  workspace     Workspace?                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  listingId     String?
  listing       StoreListing?               @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name          String
  goal          OptimizationGoal
  status        OptimizationCampaignStatus  @default(DRAFT)
  policy        Json?
  successMetric String?
  runs          OptimizationCampaignRun[]
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
}

model OptimizationCampaignRun {
  id              String               @id @default(cuid())
  campaignId      String
  campaign        OptimizationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status          AgentRunStatus       @default(PENDING)
  input           Json?
  output          Json?
  proposedActions Json?
  appliedActions  Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model ImprovementBundle {
  id          String            @id @default(cuid())
  workspaceId String?
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  listingId   String?
  listing     StoreListing?     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  title       String
  summary     String
  actions     Json
  riskLevel   SuggestionImpact  @default(MEDIUM)
  status      SuggestionStatus  @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum SelfHealingTriggerType {
  ALERT
  INCIDENT
  SCHEDULED_CHECK
  MANUAL
  WORKFLOW_FAILURE
  RUNTIME_FAILURE
  SETTLEMENT_FAILURE
  SEARCH_INDEX_FAILURE
}

enum SelfHealingRunStatus {
  PENDING
  DIAGNOSING
  PROPOSED
  APPROVED
  APPLIED
  FAILED
  DISMISSED
}

enum GlobalSignalType {
  CONVERSION_BENCHMARK
  TEMPLATE_FORK_VELOCITY
  AGENT_SUCCESS_RATE
  WORKFLOW_COMPLETION_RATE
  PLUGIN_RETENTION
  SEARCH_INTENT_CLUSTER
  MARKETPLACE_TRUST_SIGNAL
}

enum IntelligenceRecommendationType {
  APP_OPTIMIZATION
  LISTING_OPTIMIZATION
  TEMPLATE_RECOMMENDATION
  AGENT_RECOMMENDATION
  WORKFLOW_RECOMMENDATION
  PLUGIN_RECOMMENDATION
  PRICING_EXPERIMENT
  DEPLOYMENT_RECOMMENDATION
}

enum OptimizationGoal {
  STORE_CONVERSION
  APP_ONBOARDING
  TEMPLATE_FORK_RATE
  AGENT_TRUST
  WORKFLOW_COMPLETION
  PRICING_CONVERSION
  RETENTION
}

enum OptimizationCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum SuggestionImpact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SuggestionStatus {
  PENDING
  APPROVED
  APPLIED
  REJECTED
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}
