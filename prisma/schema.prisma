generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  projects         Project[]
  installs         Install[]
  rewardLedgers    RewardLedger[]
  revenueScenarios RevenueScenario[]
  analyticsEvents  AnalyticsEvent[]
  createdAt        DateTime          @default(now())
}

model Project {
  id               String            @id @default(cuid())
  name             String
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  versions         ProjectVersion[]
  listings         StoreListing[]
  installs         Install[]
  rewardLedgers    RewardLedger[]
  revenueScenarios RevenueScenario[]
  analyticsEvents  AnalyticsEvent[]
  deployments      Deployment[]
  createdAt        DateTime          @default(now())
}

model ProjectVersion {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  prompt     String?
  spec       String?
  fileTree   Json?
  code       String
  createdAt  DateTime @default(now())
}

model StoreListing {
  id             String           @id @default(cuid())
  projectId      String           @unique
  project        Project          @relation(fields: [projectId], references: [id])
  name           String
  slug           String           @unique
  description    String
  price          Float?
  pricingModel   PricingModel     @default(FREE)
  isPublished    Boolean          @default(false)
  installs       Install[]
  rewardLedgers  RewardLedger[]
  analyticsEvents AnalyticsEvent[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Deployment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  url       String
  status    String
  createdAt DateTime @default(now())
}

model Install {
  id          String       @id @default(cuid())
  listingId   String
  listing     StoreListing @relation(fields: [listingId], references: [id])
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  pricePaid   Float?
  source      String?
  createdAt   DateTime     @default(now())

  @@index([userId, listingId, projectId])
}

model RewardLedger {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id])
  listingId   String?
  listing     StoreListing?  @relation(fields: [listingId], references: [id])
  kind        RewardKind
  amountCents Int
  currency    String         @default("USD")
  note        String?
  createdAt   DateTime       @default(now())
}

model RevenueScenario {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id])
  projectId               String?
  project                 Project? @relation(fields: [projectId], references: [id])
  monthlyActiveUsers      Int      @default(0)
  conversionRate          Float    @default(0)
  averageRevenuePerUser   Float    @default(0)
  projectedMonthlyRevenue Float    @default(0)
  createdAt               DateTime @default(now())
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  userId     String?
  user       User?              @relation(fields: [userId], references: [id])
  projectId  String?
  project    Project?           @relation(fields: [projectId], references: [id])
  listingId  String?
  listing    StoreListing?      @relation(fields: [listingId], references: [id])
  eventName  AnalyticsEventName
  source     String?
  metadata   Json?
  createdAt  DateTime           @default(now())
}

enum PricingModel {
  FREE
  PAID
  SUBSCRIPTION
}

enum RewardKind {
  CREATOR_EARNING
  REFERRAL_REWARD
}

enum AnalyticsEventName {
  APP_VIEW
  STORE_VIEW
  INSTALL_CLICK
  INSTALL_COMPLETED
  PURCHASE_COMPLETED
  DEPLOYMENT_CREATED
}
