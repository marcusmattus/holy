generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  payouts              Payout[]
  creatorPayoutAccount CreatorPayoutAccount?
  ownedWorkspaces      Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  id                   String             @id @default(cuid())
  email                String             @unique
  projects             Project[]
  purchases            Purchase[]
  revenueShareRules    RevenueShareRule[]
  revenueShares        RevenueShare[]
  rewardLedgerEntries  RewardLedger[]
  referralsAsReferrer  Referral[]         @relation("ReferralReferrer")
  referralsAsReferred  Referral[]         @relation("ReferralReferred")
  installs             Install[]
  revenueScenarios     RevenueScenario[]
  analyticsEvents      AnalyticsEvent[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, path])
}

model Project {
  id               String            @id @default(cuid())
  name             String
  slug             String?           @unique
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  workspaceId      String?
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id])
  status           ProjectStatus     @default(DRAFT)
  files            ProjectFile[]
  versions         ProjectVersion[]
  listings         StoreListing[]
  installs         Install[]
  rewardLedgers    RewardLedger[]
  revenueScenarios RevenueScenario[]
  analyticsEvents  AnalyticsEvent[]
  analyticsDailyAggregates AnalyticsDailyAggregate[]
  deployments      Deployment[]
  createdAt        DateTime          @default(now())
}

model ProjectVersion {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  label      String?
  prompt     String?
  summary    String?
  spec       String?
  fileTree   Json?
  filesJson  Json?
  code       String
  createdAt  DateTime @default(now())
}

model StoreListing {
  id             String           @id @default(cuid())
  projectId      String           @unique
  project        Project          @relation(fields: [projectId], references: [id])
  name           String
  title          String
  slug           String           @unique
  description    String
  category       String           @default("General")
  price          Float?
  priceType      StoreListingPriceType @default(FREE)
  priceCents     Int              @default(0)
  currency       String           @default("gbp")
  pricingModel   PricingModel     @default(FREE)
  status         ListingStatus    @default(DRAFT)
  isPublished    Boolean          @default(false)
  installs       Install[]
  purchases      Purchase[]
  revenueShares  RevenueShare[]
  revenueShareRules RevenueShareRule[]
  referrals      Referral[]
  rewardLedgers  RewardLedger[]
  analytics      AnalyticsDailyAggregate[]
  analyticsEvents AnalyticsEvent[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Deployment {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  provider   String   @default("simulated")
  externalId String?
  url        String?
  status     String
  logs       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CreatorPayoutAccount {
  id               String              @id @default(cuid())
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeAccountId  String              @unique
  onboardingStatus PayoutAccountStatus @default(PENDING)
  payoutsEnabled   Boolean             @default(false)
  chargesEnabled   Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model Payout {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  amountCents      Int
  currency         String       @default("gbp")
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?      @unique
  metadata         Json?
  revenueShares    RevenueShare[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model AnalyticsDailyAggregate {
  id           String   @id @default(cuid())
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  listingId    String?
  listing      StoreListing? @relation(fields: [listingId], references: [id])
  date         DateTime
  views        Int      @default(0)
  installs     Int      @default(0)
  purchases    Int      @default(0)
  revenueCents Int      @default(0)
  referrals    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([projectId, listingId, date])
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  ownerId   String
  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members   WorkspaceMember[]
  projects  Project[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
}

model AppInstall {
  id         String   @id @default(cuid())
  userId     String
  listingId  String
  createdAt  DateTime @default(now())

  @@unique([userId, listingId])
}

model AppPurchase {
  id                 String   @id @default(cuid())
  userId             String
  listingId          String
  providerSessionId  String
  createdAt          DateTime @default(now())

  @@unique([providerSessionId])
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())
}

enum PayoutAccountStatus {
  PENDING
  ONBOARDING
  ACTIVE
  RESTRICTED
  DISABLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Purchase {
  id                  String          @id @default(cuid())
  listingId           String
  listing             StoreListing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId             String
  buyer               User            @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  amountCents         Int
  currency            String          @default("gbp")
  status              PurchaseStatus  @default(PENDING)
  stripeSessionId     String?         @unique
  stripePaymentIntent String?         @unique
  revenueShares       RevenueShare[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model RevenueShareRule {
  id          String           @id @default(cuid())
  listingId   String
  listing     StoreListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  role        RevenueShareRole
  basisPoints Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([listingId, recipientId, role])
}

model RevenueShare {
  id          String             @id @default(cuid())
  purchaseId  String
  purchase    Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  listingId   String?
  listing     StoreListing?      @relation(fields: [listingId], references: [id])
  recipientId String
  recipient   User               @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  role        RevenueShareRole
  amountCents Int
  currency    String             @default("gbp")
  status      RevenueShareStatus @default(PENDING)
  referralCode String?
  payoutId    String?
  payout      Payout?            @relation(fields: [payoutId], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Referral {
  id         String         @id @default(cuid())
  referrerId String
  referrer   User           @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId String?
  referred   User?          @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: SetNull)
  listingId  String?
  listing    StoreListing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  code       String         @unique
  status     ReferralStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

enum StoreListingPriceType {
  FREE
  ONE_TIME
  SUBSCRIPTION
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RevenueShareRole {
  CREATOR
  REFERRER
  PLATFORM
  COLLABORATOR
}

enum RevenueShareStatus {
  PENDING
  AVAILABLE
  PAID_OUT
  CANCELLED
}

enum RewardSourceType {
  PURCHASE
  INSTALL
  REFERRAL
  PUBLISH
  MANUAL
}

enum RewardCurrency {
  POINTS
  GBP_CENTS
  USD_CENTS
  USDC_UNITS
}

enum RewardStatus {
  PENDING
  AVAILABLE
  SETTLED
  CANCELLED
}

enum ReferralStatus {
  PENDING
  CONVERTED
  EXPIRED
}

enum ProjectStatus {
  DRAFT
  BUILDING
  READY
  PUBLISHED
  ARCHIVED
}

enum PriceType {
  FREE
  ONE_TIME
  SUBSCRIPTION
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  UNLISTED
  ARCHIVED
}

model Install {
  id          String       @id @default(cuid())
  listingId   String
  listing     StoreListing @relation(fields: [listingId], references: [id])
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id])
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  pricePaid   Float?
  source      String?
  createdAt   DateTime     @default(now())

  @@unique([listingId, userId])
  @@index([userId, listingId, projectId])
}

model RewardLedger {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  projectId        String?
  project          Project?         @relation(fields: [projectId], references: [id])
  listingId        String?
  listing          StoreListing?    @relation(fields: [listingId], references: [id])
  sourceType       RewardSourceType @default(MANUAL)
  sourceId         String?
  kind             RewardKind       @default(CREATOR_EARNING)
  amount           Int              @default(0)
  amountCents      Int              @default(0)
  currency         RewardCurrency   @default(POINTS)
  status           RewardStatus     @default(PENDING)
  description      String?
  note             String?
  metadata         Json?
  settlementTxHash String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model RevenueScenario {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id])
  projectId               String?
  project                 Project? @relation(fields: [projectId], references: [id])
  monthlyActiveUsers      Int      @default(0)
  conversionRate          Float    @default(0)
  averageRevenuePerUser   Float    @default(0)
  projectedMonthlyRevenue Float    @default(0)
  createdAt               DateTime @default(now())
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  userId     String?
  user       User?              @relation(fields: [userId], references: [id])
  projectId  String?
  project    Project?           @relation(fields: [projectId], references: [id])
  listingId  String?
  listing    StoreListing?      @relation(fields: [listingId], references: [id])
  eventType  String?
  eventName  AnalyticsEventName
  source     String?
  revenueCents Int              @default(0)
  metadata   Json?
  createdAt  DateTime           @default(now())
}

enum PricingModel {
  FREE
  PAID
  SUBSCRIPTION
}

enum RewardKind {
  CREATOR_EARNING
  REFERRAL_REWARD
}

enum AnalyticsEventName {
  APP_VIEW
  STORE_VIEW
  INSTALL_CLICK
  INSTALL_COMPLETED
  PURCHASE_COMPLETED
  DEPLOYMENT_CREATED
}
