{
  "name": "@holyos/ai-tools",
  "version": "0.1.0",
  "description": "AI tools for HolyOS — vibecoding, scaffolding, and analytics insights",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "bunchee",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "echo 'No linting configured for holyos-ai package'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["holy", "holyos", "holystic-labs", "ai", "vibecoding", "sdk"],
  "license": "Apache-2.0",
  "dependencies": {
    "holyos-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "bunchee": "^6.5.2",
    "prettier": "^3.3.3",
    "typescript": "5.7.3",
    "vitest": "^3.2.4",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "ai": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "publishConfig": {
    "access": "public"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all"
  }
}
