{
  "name": "holyos-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the HolyOS Platform API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "bunchee",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "echo 'No linting configured for holyos-sdk package'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "holy",
    "holyos",
    "holystic-labs",
    "vibecoding",
    "sdk"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.12.0",
    "bunchee": "^6.5.2",
    "prettier": "^3.3.3",
    "typescript": "5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all"
  }
}
